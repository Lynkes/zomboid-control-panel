{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zomboid-control-panel.local/schemas/modernization-results.json",
  "title": "Modernization work-package results",
  "type": "object",
  "additionalProperties": false,
  "required": ["work_package", "git_sha", "started_at", "finished_at", "commands", "outcome"],
  "properties": {
    "work_package": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "baseline_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "feature_flags": { "type": "object", "additionalProperties": { "type": ["boolean", "string", "number", "null"] } },
    "commands": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "cwd", "exit_code", "duration_ms"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "cwd": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "tests_passed": { "type": "integer", "minimum": 0 },
          "tests_failed": { "type": "integer", "minimum": 0 },
          "tests_skipped": { "type": "integer", "minimum": 0 },
          "output_excerpt": { "type": "string", "maxLength": 4000 }
        }
      }
    },
    "outcome": { "enum": ["passed", "failed", "blocked"] },
    "blocked_reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "known_risks": { "type": "array", "items": { "type": "string" } },
    "evidence_files": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "blocked" } } },
      "then": { "required": ["blocked_reason"] }
    },
    {
      "if": { "properties": { "outcome": { "enum": ["passed", "failed"] } } },
      "then": { "properties": { "commands": { "minItems": 1 } } }
    }
  ]
}
