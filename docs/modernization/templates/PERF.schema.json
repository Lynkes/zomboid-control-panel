{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zomboid-control-panel.local/schemas/modernization-performance.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["work_package", "git_sha", "captured_at", "measurements"],
  "properties": {
    "work_package": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "captured_at": { "type": "string", "format": "date-time" },
    "environment": { "type": "string" },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "samples", "p50_ms", "p95_ms"],
        "properties": {
          "name": { "type": "string" },
          "method": { "type": "string" },
          "path": { "type": "string" },
          "samples": { "type": "integer", "minimum": 1 },
          "warmup_samples": { "type": "integer", "minimum": 0 },
          "p50_ms": { "type": "number", "minimum": 0 },
          "p95_ms": { "type": "number", "minimum": 0 },
          "max_ms": { "type": "number", "minimum": 0 },
          "rss_bytes": { "type": "integer", "minimum": 0 },
          "bundle_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
