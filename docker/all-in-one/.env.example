CORS_ORIGINS=http://localhost:3001
# Direct access is the installer default. Set 1 for one reverse-proxy hop,
# or use an IP/subnet list when deploying behind a known proxy.
TRUST_PROXY=false
PANEL_DOCKER_UPDATER_TOKEN=replace-with-a-random-32-byte-secret
# Absolute host directory where the updater stores source and rollback state.
PANEL_BUILD_DIR=/absolute/path/to/zomboid-panel/build
# Optional addresses to show in the dashboard. Leave blank to auto-detect.
PANEL_LAN_IP=
PANEL_WAN_IP=
# UDP ports Docker publishes for Project Zomboid. Each server uses two in a
# row (game port and game port + 1), so 16261-16270 fits five servers. Run
# bootstrap.sh again after changing it.
PZ_GAME_PORTS=16261-16270
# Optional: SHA-256 of ONE release's source archive. While it is set, the
# updater refuses every other version, newer ones included (see SECURITY.md,
# "Panel update"). Needs the updater from the release that added it: run
# bootstrap.sh again after changing it.
# PANEL_DOCKER_UPDATE_SHA256=
